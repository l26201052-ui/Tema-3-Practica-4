package tema3;
import java.util.Scanner;
public class AnalisisNumerosAmigos {
    public static void main(String[] args){
        Scanner scanner = new Scanner(System.in);
        String repetir;
        do {
            System.out.print("Primer numero entero positivo: ");
            int a = scanner.nextInt();
            while (a <= 0) {
                System.out.print("Debe ser positivo. Primer numero: ");
                a = scanner.nextInt();
            }
            System.out.print("Segundo numero entero positivo: ");
            int b = scanner.nextInt();
            while (b <= 0) {
                System.out.print("Debe ser positivo. Segundo numero: ");
                b = scanner.nextInt();
            }
            int sumaA = 0;
            for (int i = 1; i < a; i++) {
                if (a % i == 0) {
                    sumaA += i;
                }
            }
            int sumaB = 0;
            for (int i = 1; i < b; i++) {
                if (b % i == 0) {
                    sumaB += i;
                }
            }
            System.out.println("\n1) Mostrar suma de divisores de cada numero");
            System.out.println("2) Mostrar solo el resultado de la comparacion");
            System.out.print("Opcion: ");
            int opcion = scanner.nextInt();

            switch (opcion) {
                case 1:
                    System.out.println("Suma de divisores de " + a + ": " + sumaA);
                    System.out.println("Suma de divisores de " + b + ": " + sumaB);
                    break;
                case 2:
                    if (sumaA == b && sumaB == a) {
                        System.out.println(a + " y " + b + " SON numeros amigos.");
                    } else {
                        System.out.println(a + " y " + b + " NO son numeros amigos.");
                    }
                    break;
                default:
                    System.out.println("Opcion no valida.");
            }
            System.out.print("\n Analizar otra pareja? (si/no): ");
            repetir = scanner.next();
        } while (repetir.equalsIgnoreCase("si"));
    }
}
